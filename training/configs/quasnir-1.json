{
  "run": "quasnir-1",
  "data": "data/stores/code/train.meta.json",
  "init_from": "runs/base-s/FINAL",
  "max_steps": 500,
  "lr": 0.0003,
  "min_lr": 3e-05,
  "warmup_steps": 25,
  "seed": 2,
  "model": {
    "vocab_size": 8192,
    "dim": 384,
    "n_layers": 6,
    "n_heads": 6,
    "n_kv_heads": 2,
    "ffn_hidden": 1024,
    "max_seq_len": 512
  },
  "batch": 8,
  "seq_len": 256,
  "grad_accum": 4,
  "weight_decay": 0.1,
  "grad_clip": 1.0,
  "out_dir": "runs",
  "log_every": 10,
  "eval_every": 100,
  "eval_batches": 16,
  "ckpt_every": 250,
  "threads": 0
}
